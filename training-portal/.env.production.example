APP_NAME="Ardıç Otomotiv | Eğitim Yönetim Portalı"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://training.92-5-64-118.sslip.io

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

PERSONNEL_SERVICE_URL=https://personnel.92-5-64-118.sslip.io
PERSONNEL_API_TOKEN=replace-with-the-same-random-private-token-as-personnel-service

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/ardic/training-portal/database/database.sqlite

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
